# Base URL for the backend API (FastAPI). Must be reachable from the browser.
# Example (local): NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Example (hosted): NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com
NEXT_PUBLIC_API_BASE_URL=

# Optional: site URL used by auth flows (if backend expects redirects).
NEXT_PUBLIC_SITE_URL=
